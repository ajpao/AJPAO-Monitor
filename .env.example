# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง:  cp .env.example .env
# ⚠️ ห้าม commit .env ขึ้น git (อยู่ใน .gitignore แล้ว)

# Telegram bot — สร้าง/ขอ token ใหม่จาก @BotFather
BOT_TOKEN=
# chat id หลัก (เลขผู้ใช้/กลุ่ม)
CHAT_ID=
# รายชื่อ chat id ที่อนุญาตให้สั่งบอท คั่นด้วย , (ไม่ใส่ = ใช้ CHAT_ID)
ALLOWED_IDS=

# ─── ความปลอดภัย dashboard LAN ───
# รหัสผ่านสำหรับ login เข้า dashboard ใน LAN (ว่าง = ไม่บังคับ login, ใครในวง LAN ก็เข้าได้)
# แนะนำให้ตั้ง! เพื่อกันคนในเน็ตเวิร์กเดียวกันมาสั่ง reboot/shutdown
WEB_PASSWORD=
# SECRET_KEY=               # ปล่อยว่างได้ ระบบจะ gen เก็บใน .flask_secret ให้เอง
# รายชื่อ service ที่ให้สั่ง start/stop/restart ผ่านเว็บได้ (allowlist) คั่นด้วย ,
# MANAGED_SERVICES=AdGuardHome,apache2,transmission-daemon,ssh
# EXEC_TIMEOUT=30           # web terminal: timeout ต่อคำสั่ง (วินาที)

# ─── AdGuard Home (ดึงสถิติ DNS) — ปล่อยว่าง = ปิดฟีเจอร์ ───
# ADGUARD_IP=127.0.0.1      # IP ของ AdGuard (127.0.0.1 = เครื่องเดียวกัน)
# ADGUARD_PORT=80           # พอร์ต web UI / control API
# ADGUARD_USER=             # username (Basic Auth)
# ADGUARD_PASSWORD=         # password (Basic Auth)

# ─── ตั้งค่าเพิ่มเติม (ไม่ใส่ก็ใช้ค่า default) ───
# PORT=5000                 # พอร์ต Flask dashboard (LAN)
# TEMP_ALERT=55             # เกินกี่ °C ถึงแจ้งเตือนด่วน
# COLLECT_INTERVAL=600      # เก็บข้อมูลทุกกี่วินาที (default 10 นาที)
# DAILY_REPORT_HOUR=8       # ส่งสรุปรายวันตอนกี่โมง
# REBOOT_POLL_SEC=15        # เช็คคำสั่ง reboot จาก cloud ทุกกี่วินาที
# DB_PATH=/home/ajpao/AJPAO-Monitor/temp_data.db
# SERVICE_ACCOUNT=/home/ajpao/AJPAO-Monitor/serviceAccountKey.json
