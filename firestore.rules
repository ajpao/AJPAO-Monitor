rules_version = '2';

// AJPAO-Monitor — Firestore security rules
//
//   readings / status : อ่านได้เฉพาะผู้ที่ login (cloud dashboard บังคับ login)
//                       client เขียนไม่ได้ (ตัว Pi เขียนผ่าน Admin SDK = bypass rules)
//   commands          : client อ่านไม่ได้; เขียนได้เฉพาะผู้ที่ login (reboot/shutdown/adguard)
//
// ต้องการจำกัดเฉพาะอีเมลตัวเอง: แก้เงื่อนไขเป็น
//   if request.auth != null && request.auth.token.email in ['you@gmail.com'];

service cloud.firestore {
  match /databases/{database}/documents {

    match /readings/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /status/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /commands/{doc} {
      allow read:  if false;
      allow write: if request.auth != null;
    }

    match /notes/{doc} {
      allow read, write: if request.auth != null;
    }

    match /settings/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}
